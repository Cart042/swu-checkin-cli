# 西南大学自动打卡配置
# `scripts/smoke_runtime.py` 只使用本地页面和合成图片，不读取本文件。

# 配置目录（默认是脚本所在目录；Docker 通常使用 /data）
# SWU_CONFIG_DIR=/data

# 账号来源优先级：命令行 -u/-p > users.json > SWU_USERS > 单账号环境变量。
# .env 会在读取账号前加载；进程环境变量优先于本文件。
# 单账号配置（也可使用 users.json 或 SWU_USERS）
SWU_USERNAME=your_username
SWU_PASSWORD=your_password

# 多账号 JSON 配置。users.json 存在且有效时优先于此变量。
# SWU_USERS=[{"username":"user1","password":"password1"},{"username":"user2","password":"password2"}]

# 签到并发线程数，默认 3
SWU_MAX_WORKERS=3

# 失败账号重试间隔，默认 300 秒
# SWU_RETRY_INTERVAL_SECONDS=300

# 单次任务总时限，默认 900 秒
# SWU_RUN_DEADLINE_SECONDS=900

# 推送通道共享总预算，默认 60 秒（允许 1-3600 秒）
# SWU_PUSH_DEADLINE_SECONDS=60

# 失败账号最多重试轮数，默认 3
# SWU_MAX_ROUNDS=3

# 日志输出级别：DEBUG / INFO / WARNING / ERROR
SWU_LOG_LEVEL=INFO

# 仅排查登录页问题时启用脱敏文本调试信息；文件会写入该目录并应及时清理。
# SWU_DEBUG_DIR=debug

# 消息推送通道，按需填写。
# 钉钉机器人
PUSH_DINGTALK_TOKEN=
PUSH_DINGTALK_SECRET=

# 企业微信群机器人
PUSH_QYWX_KEY=

# Bark (iOS)
PUSH_BARK_KEY=
PUSH_BARK_URL=https://api.day.app

# Server 酱
PUSH_SERVERCHAN_KEY=

# PushDeer
PUSH_PUSHDEER_KEY=

# Telegram Bot（需要同时填写 Bot Token 和 Chat ID）
PUSH_TELEGRAM_BOT_TOKEN=
PUSH_TELEGRAM_CHAT_ID=
